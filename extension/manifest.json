{
  "manifest_version": 3,
  "name": "tabctl",
  "version": "0.1.0",
  "description": "Attach a DevTools Protocol session to one specific tab and relay it to a local tabctl daemon.",
  "permissions": ["debugger", "tabs", "storage", "alarms"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "tabctl: arm/disarm debugging for this tab",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
